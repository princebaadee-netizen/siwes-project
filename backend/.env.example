# Copy this to .env and fill in real values

# Local Postgres connection string. Example for a local install:
DATABASE_URL="postgresql://postgres:password@localhost:5432/siwes_app?schema=public"

# Change this to a long random string in production
JWT_SECRET="dev-secret-change-me"

# Must match wherever the Next.js frontend runs
FRONTEND_URL="http://localhost:3000"

# Backend only. You never open this port in the browser — the frontend talks to
# /api on localhost:3000 and Next.js proxies the request here.
PORT=4001

# --- AI generation (optional) ---
# Enables bulk logbook fill-up and project chapter drafting. Without a key those
# endpoints return 503 and the buttons in the UI stay disabled.
ANTHROPIC_API_KEY=""
# Claude model used for generation. Change if you have access to a different one.
AI_MODEL="claude-sonnet-4-5"
# Dev convenience: treat every pass and the free trial as unlocked so the paid
# paths can be tested without a payment flow. NEVER enable in production.
AI_DEV_UNLOCK="false"

# --- Paystack payments (optional) ---
# From your Paystack dashboard (Settings → API Keys). Without the secret key the
# payment endpoints return 503 unless PAYSTACK_DEV_MODE is on.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Dev convenience: when no secret key is set, "Buy" grants the pass instantly so
# the gated features can be tested end-to-end. NEVER enable in production.
PAYSTACK_DEV_MODE="false"

# --- Pass pricing (optional) ---
# Prices in naira (whole ₦). Change any time then restart the backend; both the
# checkout charge and the prices shown in the app read from here.
PRICE_IT_SIWES_PASS_NAIRA="10000"    # ₦10,000
PRICE_PROJECT_PASS_NAIRA="20000"     # ₦20,000
# Optional. Defaults to 10% off the two above (currently ₦27,000).
# PRICE_BUNDLE_NAIRA="27000"

# --- Password reset email (optional) ---
# Uses Resend's HTTP API when a key is set. Without it the reset link is written
# to the backend console instead, so the flow still works locally.
RESEND_API_KEY=""
# Verified sender. The Resend default only delivers to your own address in test mode.
MAIL_FROM="SIWES Logbook <onboarding@resend.dev>"
# Dev convenience: also return the reset link in the API response (the UI shows
# it as a clickable link) when no mail provider is configured. NEVER enable in production.
PASSWORD_RESET_DEV_MODE="false"
