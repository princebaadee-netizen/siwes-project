generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App queries go through the pooled connection (Supabase transaction pooler,
  // port 6543). Prisma Migrate cannot run through a transaction pooler, so
  // migrations use directUrl instead — the direct connection or the session
  // pooler (port 5432). Locally/self-hosted, DIRECT_URL can equal DATABASE_URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum ModuleChoice {
  LOGBOOK
  PROJECT
  BOTH
}

enum LogbookEntrySource {
  MANUAL
  AI_SINGLE_DAY
  AI_BULK
}

enum EntryStatus {
  DRAFT
  REVIEWED
  FINALIZED
}

enum TopicSource {
  MANUAL
  BANK
  AI_SUGGESTED
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
}

enum ReportStatus {
  DRAFT
  COMPLETED
}

enum ReferenceSourceType {
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  BOOK
  DATASET
  THESIS
  REPORT
  STANDARD
  WEBSITE
}

enum VerificationTier {
  API_VERIFIED
  LINK_CHECKED
  STUDENT_CONFIRMED
}

enum PurchaseProductType {
  IT_SIWES_PASS
  PROJECT_PASS
  BUNDLE
}

enum PurchaseStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum GenerationType {
  EXTRACTION
  BULK_LOGBOOK
  CHAPTER_DRAFT
  SINGLE_DAY_POLISH
  TOPIC_SUGGESTION
  REPORT_SECTION
}

// The prose sections of the IT/SIWES report that the AI writes from the
// logbook. The cover and title pages are structured fields on SiwesReport
// rather than free text, so they are not listed here.
enum ReportSectionKind {
  ABSTRACT
  DEDICATION
  ACKNOWLEDGMENT
  INTRODUCTION
  INDUSTRIAL_EXPERIENCE
  SKILLS_ACQUIRED
  DISCUSSION_CONCLUSION
}

// ---------- Core ----------

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  emailVerified Boolean @default(false)
  passwordHash String
  school       String?
  department   String?
  moduleChoice ModuleChoice?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  itPlacement ITPlacement?
  projects    Project[]
  purchases   Purchase[]
  generationLogs GenerationLog[]
  passwordResetTokens PasswordResetToken[]
  siwesReport SiwesReport?

  @@map("users")
}

// ---------- Password recovery ----------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The raw token is emailed once and never stored. A database leak must not
  // hand out working reset links, so only the digest is persisted.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Purchase {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  productType PurchaseProductType
  amountKobo  Int // store in kobo to avoid float issues, e.g. 500000 = ₦5,000
  paymentRef  String              @unique
  status      PurchaseStatus      @default(PENDING)
  purchasedAt DateTime            @default(now())

  @@map("purchases")
}

// ---------- IT/SIWES Logbook ----------

model ITPlacement {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  companyName         String
  companyAddress      String?
  industrySector      String?
  startDate           DateTime
  endDate             DateTime
  daysPerWeek         Int?
  attendancePattern   String[] // e.g. ["mon","wed","thu","fri"]
  trialWeekUsed       Boolean  @default(false)
  createdAt           DateTime @default(now())

  attendanceCalendar AttendanceCalendarDay[]
  bulkFillupRequests BulkFillupRequest[]

  @@map("it_placements")
}

model PublicHoliday {
  id   String   @id @default(uuid())
  date DateTime
  name String
  year Int

  @@unique([date, name])
  @@map("public_holidays")
}

model AttendanceCalendarDay {
  id               String      @id @default(uuid())
  placementId      String
  placement        ITPlacement @relation(fields: [placementId], references: [id])
  date             DateTime
  isAttendanceDay  Boolean // derived from the pattern
  isPublicHoliday  Boolean     @default(false)
  holidayName      String?
  confirmedAttended Boolean?   // null until the student answers, for holiday or manually-flagged dates
  hasLogbookEntry  Boolean     @default(false)

  logbookEntry LogbookEntry?

  @@unique([placementId, date])
  @@map("attendance_calendar_days")
}

model BulkFillupRequest {
  id                  String      @id @default(uuid())
  placementId         String
  placement           ITPlacement @relation(fields: [placementId], references: [id])
  rawInputText         String
  extractedSchool      String?
  extractedStartDate   DateTime?
  extractedEndDate     DateTime?
  extractedSkills      String[]
  createdAt            DateTime    @default(now())

  @@map("bulk_fillup_requests")
}

model LogbookEntry {
  id               String                 @id @default(uuid())
  calendarDayId    String                 @unique
  calendarDay      AttendanceCalendarDay  @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)
  activity         String
  evidenceUrl      String?
  source           LogbookEntrySource     @default(MANUAL)
  status           EntryStatus            @default(DRAFT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("logbook_entries")
}

// ---------- IT/SIWES report ----------

// One report per student, summarising their whole IT/SIWES experience. The
// cover/title pages are assembled from the structured fields here (plus the
// uploaded logo/cover image); the prose sections live in SiwesReportSection.
model SiwesReport {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Cover / title page ---
  institutionName    String?
  institutionAddress String?
  faculty            String?
  department         String?
  programme          String? // e.g. "B.Sc. Computer Science"
  level              String? // e.g. "400 Level"
  matricNumber       String?
  schoolSupervisor   String? // SIWES coordinator / school supervisor
  companySupervisor  String? // industry-based supervisor
  durationLabel      String? // e.g. "Six Months" — auto-derived, editable
  submissionDate     DateTime?
  logoUrl            String? // institution logo (uploaded)
  coverImageUrl      String? // a ready-made cover/front page (uploaded)

  // Names the student wants woven into the Dedication / Acknowledgment.
  dedicationNames    String[] @default([])

  status      ReportStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sections SiwesReportSection[]

  @@map("siwes_reports")
}

model SiwesReportSection {
  id          String             @id @default(uuid())
  reportId    String
  report      SiwesReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind        ReportSectionKind
  content     String?
  status      EntryStatus        @default(DRAFT)
  regenerationsUsed Int          @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([reportId, kind])
  @@map("siwes_report_sections")
}

// ---------- Final Year Project ----------

// A curated, admin-maintained catalogue of project topics students can pick
// from instead of inventing one. Seeded like the public-holiday list.
model ProjectTopic {
  id          String   @id @default(uuid())
  title       String   @unique
  field       String
  description String?
  createdAt   DateTime @default(now())

  @@index([field])
  @@map("project_topics")
}

model Project {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  title        String
  supervisorName String?
  topicSource  TopicSource?
  status       ProjectStatus @default(IN_PROGRESS)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  chapters   ProjectChapter[]
  references ProjectReference[]

  @@map("projects")
}

model ProjectChapter {
  id              String      @id @default(uuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id])
  chapterNumber   Int
  title           String
  rawInputText    String?
  content         String?
  status          EntryStatus @default(DRAFT)
  isFreeUnlocked  Boolean     @default(false) // true only for chapterNumber 1
  regenerationsUsed Int       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([projectId, chapterNumber])
  @@map("project_chapters")
}

model ProjectReference {
  id                String              @id @default(uuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id])
  citationText      String
  sourceType        ReferenceSourceType
  doiOrIsbnOrLink   String?
  formattedCitation String?
  isVerified        Boolean             @default(false)
  verificationTier  VerificationTier    @default(STUDENT_CONFIRMED)
  verifiedVia       String? // e.g. "crossref", "datacite", "openlibrary"
  createdAt         DateTime            @default(now())

  @@map("project_references")
}

// ---------- Cost tracking ----------

model GenerationLog {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  type            GenerationType
  estimatedTokens Int?
  estimatedCostKobo Int?
  createdAt       DateTime       @default(now())

  @@map("generation_logs")
}
