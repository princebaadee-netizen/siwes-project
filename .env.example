# Frontend environment. Copy to `.env.local` (Next.js loads it automatically).

# Where the frontend proxies /api/* to. Leave unset locally — the default reads
# the backend's own PORT from backend/.env. Set it in a hosted deploy, e.g.:
#   API_PROXY_TARGET="https://your-api.onrender.com"
# This is server-side only (no NEXT_PUBLIC_ prefix needed).
API_PROXY_TARGET=""
